{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blooptopia",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "blooptopia-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5200",
        "--directory",
        "dist"
      ],
      "port": 5200
    }
  ]
}
